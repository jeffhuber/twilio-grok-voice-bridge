# Copy to .env and fill locally. Never commit .env.
# Flags below are on only when the value is exactly 1. true, yes, and 0 do not enable them.
# NODE_ENV is not an operator setting. Never set NODE_ENV=test in .env.
# Exactly test in the shell exports the in-process test setters. The test hooks ignore .env.
# Preloading via -r/--require/--import dotenv/config or --env-file in execArgv or NODE_OPTIONS is refused. Leave it unset.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# xAI Grok Voice
XAI_API_KEY=
# Default voice id. GROK_VOICE is used when XAI_VOICE is unset. Built-in aliases include ara.
XAI_VOICE=ara
GROK_VOICE=
XAI_VOICE_MODEL=grok-voice-latest
# Optional JSON object of alias to voice id, merged over the built-in aliases.
VOICE_ALIASES=

# HTTP
PORT=3000
# Hostname only, no scheme. Example: bridge.example.com
# When TWILIO_AUTH_TOKEN is set, this host is part of the URL checked against X-Twilio-Signature.
# A mismatch returns 403 from /twiml-connect. An empty value makes /call and /twiml-connect return 500.
PUBLIC_HOST=

# Operator routes (/call /steer /hangup /voice /transcript).
# The process exits on startup if this is empty unless ALLOW_UNAUTHENTICATED_OPERATOR is exactly 1.
# Required for operator routes and for media HMAC. When MEDIA_STREAM_SECRET is empty, this value is the HMAC key.
BRIDGE_API_KEY=
# Dedicated media HMAC key. Used only when BRIDGE_API_KEY is also set.
# When non-empty after trim, signatures use this instead of BRIDGE_API_KEY.
# If BRIDGE_API_KEY is unset, signatures are not minted or verified.
MEDIA_STREAM_SECRET=
# Exactly 1 allows startup without BRIDGE_API_KEY. Operator routes are then open.
# Media HMAC stays off even if MEDIA_STREAM_SECRET is set. Local demos only.
ALLOW_UNAUTHENTICATED_OPERATOR=

# HMAC signature lifetime in milliseconds. Default 120000.
MEDIA_AUTH_WINDOW_MS=120000

# Exactly 1 enables dual-channel Twilio recording. Any other value leaves recording off.
ENABLE_RECORDING=
# Exactly 1 removes the AI-disclosure block from instructions. Any other value leaves disclosure on.
SKIP_AI_DISCLOSURE=
# Exactly 1 logs transcript lines to stdout. Any other value leaves them off.
# An IPv4 address or calendar date is exempt per whitespace-delimited token. An IPv4 address with leading zeros is not exempt.
LOG_TRANSCRIPTS=

# Every 2 minutes, a session that already connected and whose sockets are both closed is removed without a hangup.
# A session that still has a socket open and is older than this many milliseconds is hung up.
# Default 7200000.
SESSION_MAX_AGE_MS=7200000
# A never-connected (still ringing) session is kept until it is older than this many milliseconds.
# Default 600000 (10 minutes). Only an integer of at least 60000 is kept. Other values warn and use the default.
NEVER_CONNECTED_TIMEOUT_MS=600000
# Exactly 1 disables the greeting sent when the stream connects. Any other value, including unset, leaves it on.
# DISABLE_OPENER_ON_CONNECT=

# Optional contact pack for restaurant-book. Leave unset to avoid inventing a callback number.
# Example fictional number: +15555550100
CONTACT_FULL_NAME=
CONTACT_MOBILE=

# Voice activity and barge-in. Defaults match src/server.js.
VAD_THRESHOLD=0.7
VAD_SILENCE_MS=800
VAD_PREFIX_MS=300
VAD_SOFT_THRESHOLD=0.72
VAD_SOFT_SILENCE_MS=350
BARGE_IN_CONFIRM_MS=280
BARGE_IN_COOLDOWN_MS=450
BARGE_IN_MIN_AGENT_MS=300
SOFT_CONTINUE_MS=400
SOFT_CONTINUE_MAX=8
HOLD_GRACE_MS=8000
HOLD_FRAMES=120

# Ops scripts (ops/*.sh), not read by src/server.js. See ops/README.md when those scripts are installed.
# BRIDGE_HOME=
# TWILIO_BRIDGE_RUN_DIR=
# TWILIO_BRIDGE_LOG_DIR=
# TWILIO_BRIDGE_LOG_MAX_BYTES=5242880
# CLOUDFLARED_BIN=
# CLOUDFLARED_CONFIG=
# TUNNEL_NAME=twilio-bridge
# NODE_BIN=
# BRIDGE_ENTRY=src/server.js
# SKIP_TUNNEL=
# BRIDGE_ENV_FILE=
# PROC_ROOT=/proc
# XDG_RUNTIME_DIR is not used. Pid files default to /tmp/twilio-bridge-<uid> unless TWILIO_BRIDGE_RUN_DIR is set.
