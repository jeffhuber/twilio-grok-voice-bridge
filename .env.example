TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
XAI_API_KEY=
XAI_VOICE=ara
PORT=3000
PUBLIC_HOST=
BRIDGE_API_KEY=
ALLOW_UNAUTHENTICATED_OPERATOR=
# Optional dedicated media HMAC key. Used only when BRIDGE_API_KEY is also set.
# When non-empty after trim, signatures use this instead of BRIDGE_API_KEY so the
# two keys can rotate separately. If BRIDGE_API_KEY is unset, this value is ignored
# and signatures are not minted or verified. Both keys are read once at startup.
MEDIA_STREAM_SECRET=
MEDIA_AUTH_WINDOW_MS=120000
ENABLE_RECORDING=
SKIP_AI_DISCLOSURE=
LOG_TRANSCRIPTS=
CONTACT_FULL_NAME=
CONTACT_MOBILE=
BARGE_IN_CONFIRM_MS=280
SOFT_CONTINUE_MS=400
# Exactly 1 disables the greeting sent when the stream connects. Any other value, including unset, leaves it on.
# DISABLE_OPENER_ON_CONNECT=
